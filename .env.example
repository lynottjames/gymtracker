# Copy to `.env` and fill in credentials (never commit `.env`).
# PostgreSQL connection string (Neon, Vercel Postgres, etc.)
DATABASE_URL="postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# NextAuth / Auth.js — use a long random string in production (see `openssl rand -base64 32`)
AUTH_SECRET=
